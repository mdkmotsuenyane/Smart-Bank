<Window x:Class="SmartBank.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartBank"
        mc:Ignorable="d"
        Title="SmartBank - Login" Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Color Palette - Denver Nuggets Inspired -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#0E2240"/>      <!-- Navy Blue - Trust -->
        <SolidColorBrush x:Key="SecondaryColor" Color="#FDBB30"/>    <!-- Gold - Premium -->
        <SolidColorBrush x:Key="AccentColor" Color="#C8102E"/>       <!-- Red - Alerts/Warning -->
        <SolidColorBrush x:Key="LightGold" Color="#FFE58F"/>         <!-- Light Gold - Highlights -->
        <SolidColorBrush x:Key="DarkColor" Color="#0A1628"/>         <!-- Dark Navy -->
        <SolidColorBrush x:Key="LightColor" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#C8102E"/>

        <!-- Material Design TextBox Style -->
        <Style x:Key="MaterialTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DarkColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="15,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SecondaryColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#9AA0A6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Material Design PasswordBox Style -->
        <Style x:Key="MaterialPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DarkColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="15,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SecondaryColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style - Gold for Premium Banking -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryColor}"/>
            <Setter Property="Foreground" Value="{StaticResource DarkColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5A820"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CC921C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Social Login Button Style -->
        <Style x:Key="SocialButton" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#F1F3F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="25" 
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8EAED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================== -->
        <!-- LEFT SIDE - BRANDING          -->
        <!-- ============================== -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryColor}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <!-- Logo -->
                <Border Background="{StaticResource SecondaryColor}" 
                        CornerRadius="20" 
                        Width="80" 
                        Height="80" 
                        HorizontalAlignment="Center">
                    <TextBlock Text="🏦" FontSize="48" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="SmartBank" 
                           FontSize="36" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource SecondaryColor}"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,5"/>
                <TextBlock Text="Premium Banking Services" 
                           FontSize="14" 
                           Foreground="{StaticResource LightGold}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Features -->
                <Border Background="{StaticResource SecondaryColor}" 
                        Opacity="0.12" 
                        CornerRadius="12" 
                        Padding="20" 
                        Margin="0,20">
                    <StackPanel>
                        <TextBlock Text="✓ Secure Banking" Foreground="{StaticResource LightGold}" FontSize="14" Margin="0,5" FontWeight="SemiBold"/>
                        <TextBlock Text="✓ Premium Investment" Foreground="{StaticResource LightGold}" FontSize="14" Margin="0,5"/>
                        <TextBlock Text="✓ Global Transfers" Foreground="{StaticResource LightGold}" FontSize="14" Margin="0,5"/>
                        <TextBlock Text="✓ 24/7 Support" Foreground="{StaticResource LightGold}" FontSize="14" Margin="0,5"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Join 10,000+ Satisfied Clients" 
                           Foreground="{StaticResource LightGold}" 
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <!-- ============================== -->
        <!-- RIGHT SIDE - LOGIN            -->
        <!-- ============================== -->
        <Border Grid.Column="1" Background="White">
            <Grid Margin="50,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,40">
                    <TextBlock Text="Welcome Back!" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryColor}"/>
                    <TextBlock Text="Sign in to access your account" 
                               FontSize="14" 
                               Foreground="#5F6368"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Login Form -->
                <StackPanel Grid.Row="1">
                    <!-- Account Number -->
                    <TextBlock Text="Account Number" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource DarkColor}"
                               Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource MaterialTextBox}" 
                             x:Name="AccountNumberInput"  
                             KeyDown="AccountNumberInput_KeyDown"
                             Margin="0,0,0,20"/>

                    <!-- PIN -->
                    <TextBlock Text="PIN" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource DarkColor}"
                               Margin="0,0,0,8"/>
                    <PasswordBox Style="{StaticResource MaterialPasswordBox}" 
                                 x:Name="PinInput" 
                                 KeyDown="PinInput_KeyDown"
                                 Margin="0,0,0,10"/>

                    <!-- Demo Accounts helper -->
                    <TextBlock Text="View Demo Accounts" 
                               Foreground="{StaticResource SecondaryColor}" 
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Cursor="Hand"
                               MouseLeftButtonDown="DemoAccounts_MouseLeftButtonDown"
                               Margin="0,0,0,30"/>

                    <!-- Login Button -->
                    <Button Style="{StaticResource PrimaryButton}" 
                            Content="Sign In"
                            x:Name="LoginBtn"
                            Click="LoginBtn_Click"/>

                    <!-- Divider -->
                    <Grid Margin="0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Rectangle Grid.Column="0" 
                                   Fill="#DADCE0" 
                                   Height="1" 
                                   VerticalAlignment="Center"/>


                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>